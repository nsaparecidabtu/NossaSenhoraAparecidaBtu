// ==========================================
// CONFIGURAÇÃO DO GERADOR E FONTE DE DADOS
// ==========================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  //url      = env("DATABASE_URL")
}

// ==========================================
// MÓDULO DE AUTENTICAÇÃO E USUÁRIOS (RBAC)
// ==========================================

model User {
  id            String            @id @default(cuid())
  name          String?
  email         String?           @unique
  emailVerified DateTime?
  image         String?
  staffRole     StaffRole?        // Papel global do sistema (ex: SUPER_ADMIN, STAFF, MINISTRY_LEADER)
  permissions   StaffPermission[] @default([]) // Permissões granulares atribuídas ao STAFF
  createdAt     DateTime          @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  

  // Relações do Auth.js (NextAuth v5)
  accounts      Account[]
  sessions      Session[]

  // Relação N-para-N flexível com Ministérios/Pastorais
  memberships   UserMinistryMembership[]

  // Relação opcional de perfil operacional de Catequista
  catechistProfile Catechist?

  // Relações com módulos do sistema
  contactRequests ContactRequest[]
  testimonials    Testimonial[]
  catechismMarks  CatechismAttendance[] @relation("MarkedByRelation")

  @@index([email])
}

// Tabela intermediária flexível para vínculo com múltiplos ministérios/pastorais
model UserMinistryMembership {
  id         String       @id @default(cuid())
  userId     String
  ministryId String
  role       MinistryRole @default(MEMBER)
  createdAt  DateTime     @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ministry Ministry @relation(fields: [ministryId], references: [id], onDelete: Cascade)

  @@unique([userId, ministryId])
  @@index([userId])
  @@index([ministryId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==========================================
// CONFIGURAÇÕES E DADOS INSTITUCIONAIS
// ==========================================

model ParishSettings {
  id                           String              @id @default("singleton")
  name                         String              @default("Paróquia Nossa Senhora Aparecida")
  patronSaintName              String              @default("Nossa Senhora Aparecida")
  address                      String?
  phone                        String?
  email                        String?
  pixKey                       String?
  instagramUrl                 String?
  facebookUrl                  String?
  youtubeUrl                   String?
  heroImageUrl                 String?
  heroTagline                  String?             @default("Lar de fé, esperança e devoção")
  aboutText                    String?
  aboutImageUrl                String?
  patronStoryText              String?
  requireLoginForPrayer        Boolean             @default(false)
  requireLoginForMassIntention Boolean             @default(false)
  requireLoginForSacrament     Boolean             @default(true)
  requireLoginForGeneral       Boolean             @default(false)
  liturgicalThemeMode          LiturgicalThemeMode @default(DISCRETO)
  updatedAt                    DateTime            @updatedAt
}

model SiteContact {
  id        String   @id @default(cuid())
  category  String   // 'INSTAGRAM', 'FACEBOOK', 'WHATSAPP', 'PHONE', 'ADDRESS', 'OTHER'
  label     String
  value     String
  mapUrl    String?
  createdAt DateTime @default(now())

  @@index([category])
}

model MassSchedule {
  id        String   @id @default(cuid())
  label     String
  times     String[]
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  eventDate   DateTime
  location    String?
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([eventDate])
}

model GalleryImage {
  id        String   @id @default(cuid())
  imageUrl  String
  caption   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Ministry {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  description     String?  @db.Text
  contactInfo     String?
  meetingSchedule String?
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  userMemberships UserMinistryMembership[]
}

model FaqItem {
  id        String   @id @default(cuid())
  question  String
  answer    String   @db.Text
  category  String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DailyWord {
  id               String   @id @default(cuid())
  date             DateTime @unique
  verseReference   String
  text             String   @db.Text
  reflection       String?  @db.Text
  instagramReelUrl String?
  showTextWithReel Boolean  @default(true)
  createdAt        DateTime @default(now())

  @@index([date])
}

model LiveStreamSettings {
  id               String         @id @default("singleton")
  mode             LiveStreamMode @default(MANUAL)
  youtubeVideoId   String?
  youtubeChannelId String?
  isLiveNow        Boolean        @default(false)
  updatedAt        DateTime       @updatedAt
}

model TitheRaffleWinner {
  id          String   @id @default(cuid())
  month       Int
  year        Int
  winnerName  String
  photoUrl    String?
  message     String?  @db.Text
  publishedAt DateTime @default(now())

  @@unique([month, year])
}

model ContactRequest {
  id              String               @id @default(cuid())
  type            ContactRequestType
  name            String
  contact         String?
  message         String               @db.Text
  userId          String?
  preferredDate   DateTime?
  sacramentType   SacramentType?
  wantsPublicWall Boolean              @default(false)
  approvedForWall Boolean              @default(false)
  status          ContactRequestStatus @default(PENDING)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([type, status])
  @@index([userId])
}

model LiturgicalOverride {
  id        String   @id @default(cuid())
  label     String
  startDate DateTime
  endDate   DateTime
  colorHex  String
  createdAt DateTime @default(now())

  @@index([startDate, endDate])
}

model Testimonial {
  id        String   @id @default(cuid())
  userId    String
  message   String   @db.Text
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([approved])
  @@index([userId])
}

// ==========================================
// MÓDULO DE CATEQUESE
// ==========================================

model CatechismStudent {
  id          String   @id @default(cuid())
  name        String
  active      Boolean  @default(true)
  stage       CatechismStage
  catechistId String
  createdAt   DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  catechist   Catechist             @relation(fields: [catechistId], references: [id], onDelete: Restrict)
  attendances CatechismAttendance[]

  @@index([name])
  @@index([catechistId])
  @@index([stage])
}

model Catechist {
  id        String           @id @default(cuid())
  name      String
  stages    CatechismStage[]
  active    Boolean          @default(true)
  userId    String?          @unique
  createdAt DateTime         @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user        User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  students    CatechismStudent[]
  attendances CatechismAttendance[]
}

model CatechismWeek {
  id              String   @id @default(cuid())
  title           String
  token           String   @unique
  isOpen          Boolean  @default(true)
  startsAt        DateTime @default(now())
  endsAt          DateTime?
  weeklyPassword  String?
  requirePassword Boolean  @default(false)
  createdAt       DateTime @default(now())

  attendances CatechismAttendance[]

  @@index([token])
}

model CatechismAttendance {
  id             String   @id @default(cuid())
  weekId         String
  studentId      String
  catechistId    String
  massLabel      String
  attendedAt     DateTime
  source         String   @default("SELF") // "SELF", "CATECHIST", "ADMIN"
  markedByUserId String?
  note           String?
  createdAt      DateTime @default(now())

  week         CatechismWeek    @relation(fields: [weekId], references: [id], onDelete: Cascade)
  student      CatechismStudent @relation(fields: [studentId], references: [id], onDelete: Cascade)
  catechist    Catechist        @relation(fields: [catechistId], references: [id], onDelete: Cascade)
  markedByUser User?            @relation("MarkedByRelation", fields: [markedByUserId], references: [id], onDelete: SetNull)

  @@index([weekId, catechistId])
  @@index([studentId, attendedAt])
}

// ==========================================
// ENUMS DO SISTEMA
// ==========================================

enum StaffRole {
  SUPER_ADMIN      // Acesso total a todas as configurações e módulos
  STAFF            // Membro da equipe com permissões específicas
  MINISTRY_LEADER  // Coordenador/Líder de pastoral ou ministério específico
  USER             // Usuário comum / Fiel
}

enum MinistryRole {
  COORDINATOR
  MEMBER
}

enum StaffPermission {
  VIEW_PRAYER_REQUESTS
  MANAGE_TITHE_RAFFLE
  MANAGE_EVENTS
  MANAGE_GALLERY
  MANAGE_MASS_SCHEDULE
  MANAGE_MINISTRIES
  MANAGE_FAQ
  MANAGE_LITURGICAL_THEME
  MANAGE_TESTIMONIALS
  MANAGE_CATECHISM

}

enum LiveStreamMode {
  MANUAL
  AUTO
}

enum ContactRequestType {
  PRAYER_GENERAL
  MASS_INTENTION
  SACRAMENT
  GENERAL_CONTACT
  LIVE_PRAYER
}

enum SacramentType {
  BAPTISM
  MARRIAGE
  CONFIRMATION
  FIRST_COMMUNION
}

enum ContactRequestStatus {
  PENDING
  APPROVED
  RESOLVED
  REJECTED
}

enum LiturgicalThemeMode {
  PADRAO
  DISCRETO
  FULLCOLOR
}

enum CatechismStage {
  PRE
  ETAPA_1
  ETAPA_2
  PERSEVERANCE
  ADULT
}


// ==========================================
// MÓDULO DE TRANSMISSÕES E CANAIS DO YOUTUBE
// ==========================================

model YoutubeChannel {
  id            String   @id @default(cuid())
  name          String   // Nome do Canal (Ex: Paróquia N. Sra. Aparecida)
  handle        String?  // Ex: @paroquiaaparecidabotucatu
  channelId     String   @unique // ID técnico da API (UC...)
  avatarUrl     String?  // Foto de perfil vinda da API do YouTube
  subscriberCount String? // Métricas do canal em tempo real
  isPrimary     Boolean  @default(false) // Canal principal de transmissão
  isActive      Boolean  @default(true)  // Chaveador de Ativo / Suspenso temporariamente
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isActive, isPrimary])
}