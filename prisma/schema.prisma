generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// MÓDULO DE AUTENTICAÇÃO E USUÁRIOS (RBAC)
// ==========================================

model User {
  id              String            @id @default(cuid())
  name            String?
  email           String?           @unique
  emailVerified   DateTime?
  image           String?
  staffRole       StaffRole?        // Papel global (ex: SUPER_ADMIN)
  permissions     StaffPermission[] @default([]) // Permissões globais legadas
  createdAt       DateTime          @default(now())

  // Relação cruzada: Um usuário pode participar de múltiplos ministérios com papéis diferentes
  memberships     UserMinistryMembership[]

  // Relação opcional caso este usuário seja também um Catequista operando o sistema
  catechistProfile Catechist?

  // Relações padrão do Auth.js e do sistema
  accounts        Account[]
  sessions        Session[]
  contactRequests ContactRequest[]
  testimonials    Testimonial[]
  catechismMarks  CatechismAttendance[]
  ministry        Ministry?         @relation(fields: [ministryId], references: [id]) // Mantido para retrocompatibilidade
  ministryId      String?
}

// Tabela intermediária para resolver o cruzamento de pastorais (Ex: Líder no Dízimo, Membro na Pascom)
model UserMinistryMembership {
  id         String       @id @default(cuid())
  userId     String
  ministryId String
  role       MinistryRole @default(MEMBER)
  createdAt  DateTime     @default(now())

  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  ministry   Ministry     @relation(fields: [ministryId], references: [id], onDelete: Cascade)

  @@unique([userId, ministryId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==========================================
// CONFIGURAÇÕES E CONTEÚDO PAROQUIAL
// ==========================================

model ParishSettings {
  id                           String              @id @default("singleton")
  name                         String              @default("Paróquia Nossa Senhora Aparecida")
  patronSaintName              String              @default("Nossa Senhora Aparecida")
  address                      String?
  phone                        String?
  email                        String?
  pixKey                       String?
  instagramUrl                 String?
  facebookUrl                  String?
  youtubeUrl                   String?
  heroImageUrl                 String?
  heroTagline                  String?             @default("Lar de fé, esperança e devoção")
  aboutText                    String?
  aboutImageUrl                String?
  patronStoryText              String?
  requireLoginForPrayer        Boolean             @default(false)
  requireLoginForMassIntention Boolean             @default(false)
  requireLoginForSacrament     Boolean             @default(true)
  requireLoginForGeneral       Boolean             @default(false)
  updatedAt                    DateTime            @updatedAt
  liturgicalThemeMode          LiturgicalThemeMode @default(DISCRETO)
}

model MassSchedule {
  id        String   @id @default(cuid())
  label     String
  times     String[]
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String?
  eventDate   DateTime
  location    String?
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GalleryImage {
  id        String   @id @default(cuid())
  imageUrl  String
  caption   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Ministry {
  id              String                   @id @default(cuid())
  name            String
  slug            String                   @unique
  description     String?
  contactInfo     String?
  meetingSchedule String?
  order           Int                      @default(0)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  
  members         User[]                   // Relacionamento legado
  userMemberships UserMinistryMembership[] // Novo relacionamento flexível N-para-N
}

model FaqItem {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DailyWord {
  id               String   @id @default(cuid())
  date             DateTime @unique
  verseReference   String
  text             String
  reflection       String?
  createdAt        DateTime @default(now())
  instagramReelUrl String?
  showTextWithReel Boolean  @default(true)
}

model LiveStreamSettings {
  id               String         @id @default("singleton")
  mode             LiveStreamMode @default(MANUAL)
  youtubeVideoId   String?
  youtubeChannelId String?
  isLiveNow        Boolean        @default(false)
  updatedAt        DateTime       @updatedAt
}

model TitheRaffleWinner {
  id          String   @id @default(cuid())
  month       Int
  year        Int
  winnerName  String
  photoUrl    String?
  message     String?
  publishedAt DateTime @default(now())

  @@unique([month, year])
}

model ContactRequest {
  id              String               @id @default(cuid())
  type            ContactRequestType
  name            String
  contact         String
  message         String
  userId          String?
  preferredDate   DateTime?
  sacramentType   SacramentType?
  wantsPublicWall Boolean              @default(false)
  approvedForWall Boolean              @default(false)
  status          ContactRequestStatus @default(PENDING)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  user            User?                @relation(fields: [userId], references: [id])

  @@index([type, status])
}

model LiturgicalOverride {
  id        String   @id @default(cuid())
  label     String
  startDate DateTime
  endDate   DateTime
  colorHex  String
  createdAt DateTime @default(now())

  @@index([startDate, endDate])
}

model Testimonial {
  id        String   @id @default(cuid())
  userId    String
  message   String
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([approved])
}

// ==========================================
// MÓDULO DE CATEQUESE
// ==========================================

model CatechismStudent {
  id          String                @id @default(cuid())
  name        String
  active      Boolean               @default(true)
  createdAt   DateTime              @default(now())
  catechistId String
  stage       CatechismStage
  attendances CatechismAttendance[]
  catechist   Catechist             @relation(fields: [catechistId], references: [id])

  @@index([name])
}

model CatechismAttendance {
  id             String           @id @default(cuid())
  studentId      String
  massLabel      String
  attendedAt     DateTime
  source         String           @default("SELF")
  markedByUserId String?
  note           String?
  createdAt      DateTime         @default(now())
  catechistId    String
  catechistName  String
  stage          CatechismStage
  studentName    String
  weekId         String
  catechist      Catechist        @relation(fields: [catechistId], references: [id])
  markedByUser   User?            @relation(fields: [markedByUserId], references: [id])
  student        CatechismStudent @relation(fields: [studentId], references: [id])
  week           CatechismWeek    @relation(fields: [weekId], references: [id], onDelete: Cascade)

  @@index([weekId, catechistId])
  @@index([studentId, attendedAt])
}

model Catechist {
  id          String                @id @default(cuid())
  name        String
  stages      CatechismStage[]
  active      Boolean               @default(true)
  createdAt   DateTime              @default(now())
  
  // Vínculo inteligente opcional com a tabela de Usuários do sistema
  userId      String?               @unique
  user        User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)

  attendances CatechismAttendance[]
  students    CatechismStudent[]
}

model CatechismWeek {
  id              String                @id @default(cuid())
  title           String
  token           String                @unique
  isOpen          Boolean               @default(true)
  startsAt        DateTime              @default(now())
  endsAt          DateTime?
  weeklyPassword  String?
  requirePassword Boolean               @default(false)
  createdAt       DateTime              @default(now())
  attendances     CatechismAttendance[]
}

// ==========================================
// ENUMS DO SISTEMA
// ==========================================

enum StaffRole {
  SUPER_ADMIN
  MINISTRY_LEADER
}

enum MinistryRole {
  COORDINATOR
  MEMBER
}

enum StaffPermission {
  VIEW_PRAYER_REQUESTS
  MANAGE_TITHE_RAFFLE
  MANAGE_EVENTS
  MANAGE_GALLERY
  MANAGE_MASS_SCHEDULE
  MANAGE_MINISTRIES
  MANAGE_FAQ
  MANAGE_LITURGICAL_THEME
  MANAGE_TESTIMONIALS
  MANAGE_CATECHISM
}

enum LiveStreamMode {
  MANUAL
  AUTO
}

enum ContactRequestType {
  PRAYER
  MASS_INTENTION
  SACRAMENT
  GENERAL
}

enum SacramentType {
  BAPTISM
  MARRIAGE
  CONFIRMATION
  FIRST_COMMUNION
}

enum ContactRequestStatus {
  PENDING
  CONTACTED
  RESOLVED
}

enum LiturgicalThemeMode {
  PADRAO
  DISCRETO
  FULLCOLOR
}

enum CatechismStage {
  PRE
  ETAPA_1
  ETAPA_2
  PERSEVERANCE
  ADULT
  
}